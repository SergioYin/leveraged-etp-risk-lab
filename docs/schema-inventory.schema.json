{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema Inventory",
  "type": "object",
  "required": ["schema_version", "document_type", "summary", "schemas", "provenance"],
  "properties": {
    "schema_version": {"const": "0.26"},
    "document_type": {"const": "schema_inventory"},
    "summary": {
      "type": "object",
      "required": ["schemas", "examples", "safety_flags"],
      "properties": {
        "schemas": {"type": "integer"},
        "examples": {"type": "integer"},
        "safety_flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "document_type",
          "schema_version",
          "required_top_level_fields",
          "examples",
          "public_safety_notes"
        ],
        "properties": {
          "path": {"type": "string"},
          "title": {"type": "string"},
          "document_type": {"type": ["string", "null"]},
          "schema_version": {"type": ["string", "null"]},
          "required_top_level_fields": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "string"}},
          "public_safety_notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["command", "schema_dir", "examples_dir", "live_market_data", "shell_out", "private_context", "broker_execution"],
      "properties": {
        "command": {"const": "schema-inventory"},
        "schema_dir": {"type": "string"},
        "examples_dir": {"type": "string"},
        "live_market_data": {"const": false},
        "shell_out": {"const": false},
        "private_context": {"const": false},
        "broker_execution": {"const": false}
      }
    }
  }
}
