{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Trail",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "inputs",
    "summary",
    "artifacts",
    "checklist",
    "ledger_rows",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.20"},
    "document_type": {"const": "audit_trail"},
    "inputs": {"type": "object", "required": ["ledger", "artifacts"]},
    "summary": {
      "type": "object",
      "required": ["ledger_rows", "artifacts", "passed", "review", "deterministic"]
    },
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "checklist": {"type": "array", "items": {"type": "object"}},
    "ledger_rows": {"type": "array", "items": {"type": "object"}},
    "provenance": {
      "type": "object",
      "required": ["command", "ledger", "artifacts", "live_market_data", "shell_out"],
      "properties": {
        "command": {"const": "audit-trail"},
        "ledger": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "live_market_data": {"const": false},
        "shell_out": {"const": false}
      }
    }
  },
  "additionalProperties": false
}
