{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leveraged Product Glossary",
  "type": "object",
  "required": ["schema_version", "document_type", "not_investment_advice", "summary", "terms", "provenance"],
  "properties": {
    "schema_version": {"const": "0.14"},
    "document_type": {"const": "glossary"},
    "not_investment_advice": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["terms"],
      "properties": {
        "terms": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "term", "plain_language", "why_it_matters", "example", "related_terms"],
        "properties": {
          "id": {"type": "string"},
          "term": {"type": "string"},
          "plain_language": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "example": {"type": "string"},
          "related_terms": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"const": "glossary-list"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
