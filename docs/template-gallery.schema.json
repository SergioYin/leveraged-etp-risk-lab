{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leveraged ETP product template gallery",
  "type": "object",
  "required": ["schema_version", "document_type", "templates"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "document_type": {"const": "template_gallery"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ticker",
          "underlying",
          "leverage",
          "annual_fee",
          "currency",
          "reset_frequency",
          "notes",
          "risk_notes",
          "use_cases"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "ticker": {"type": "string"},
          "underlying": {"type": "string"},
          "leverage": {"type": "number"},
          "annual_fee": {"type": "number", "minimum": 0},
          "currency": {"type": "string"},
          "reset_frequency": {"type": "string"},
          "notes": {"type": "string"},
          "risk_notes": {"type": "array", "items": {"type": "string"}},
          "use_cases": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
