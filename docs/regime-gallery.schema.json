{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leveraged ETP market regime gallery",
  "type": "object",
  "required": ["schema_version", "document_type", "regimes"],
  "properties": {
    "schema_version": {"const": "0.7"},
    "document_type": {"const": "regime_gallery"},
    "regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "default_days",
          "tags",
          "risk_notes",
          "use_cases",
          "sample_path"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "default_days": {"type": "integer", "minimum": 1},
          "tags": {"type": "array", "items": {"type": "string"}},
          "risk_notes": {"type": "array", "items": {"type": "string"}},
          "use_cases": {"type": "array", "items": {"type": "string"}},
          "sample_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["day", "label", "underlying_return"],
              "properties": {
                "day": {"type": "integer", "minimum": 1},
                "label": {"type": "string"},
                "underlying_return": {"type": "number"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
